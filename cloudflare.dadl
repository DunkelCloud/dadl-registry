        group_id: { type: string, in: path, required: true }
      pagination: none

    create_access_group:
      method: POST
      path: /accounts/{account_id}/access/groups
      access: write
      description: "Create an Access group"
      params:
        account_id: { type: string, in: path, required: true }
        name: { type: string, in: body, required: true }
        include: { type: array, in: body, required: true, description: "Include rules (OR logic): email, email_domain, ip, everyone, service_token, group, azure, github, gsuite, okta, saml, certificate, geo" }
        exclude: { type: array, in: body, description: "Exclude rules (NOT logic)" }
        require: { type: array, in: body, description: "Require rules (AND logic)" }
      pagination: none

    update_access_group:
      method: PUT
      path: /accounts/{account_id}/access/groups/{group_id}
      access: write
      description: "Update an Access group"
      params:
        account_id: { type: string, in: path, required: true }
        group_id: { type: string, in: path, required: true }
        name: { type: string, in: body }
        include: { type: array, in: body }
        exclude: { type: array, in: body }
        require: { type: array, in: body }
      pagination: none

    delete_access_group:
      method: DELETE
      path: /accounts/{account_id}/access/groups/{group_id}
      access: dangerous
      description: "Delete an Access group"
      params:
        account_id: { type: string, in: path, required: true }
        group_id: { type: string, in: path, required: true }
      pagination: none

    # =========================================================================
    # EMAIL ROUTING -- Zone settings & DNS
    # =========================================================================

    get_email_routing_settings:
      method: GET
      path: /zones/{zone_id}/email/routing
      access: read
      description: "Get the Email Routing state of a zone: enabled, status (ready | unconfigured | misconfigured | misconfigured/locked | unlocked), support_subaddress (plus-addressing), skip_wizard, created/modified. Call this first -- routing rules only take effect while status is 'ready'."
      params:
        zone_id: { type: string, in: path, required: true }
      pagination: none

    update_email_routing_settings:
      method: PATCH
      path: /zones/{zone_id}/email/routing
      access: write
      description: "Update Email Routing zone settings: support_subaddress (honor plus-addressing like user+tag@zone when matching rules) and skip_wizard. Omitted fields keep their value. Cannot switch routing on or off -- use enable_email_routing / disable_email_routing for that."
      params:
        zone_id: { type: string, in: path, required: true }
        support_subaddress: { type: boolean, in: body, description: "Honor subaddressing (user+tag@zone) when matching incoming mail against rules" }
        skip_wizard: { type: boolean, in: body, description: "Mark the dashboard configuration wizard as skipped" }
      pagination: none

    get_email_routing_dns_records:
      method: GET
      path: /zones/{zone_id}/email/routing/dns
      access: read
      description: "Show the DNS records Email Routing needs on this zone -- MX route1/2/3.mx.cloudflare.net, an SPF TXT record at the apex and the DKIM TXT record cf2024-1._domainkey -- each as {type, name, content, priority, ttl}. Works for zones where routing is not enabled yet (shows what enable_email_routing would create and lock)."
      params:
        zone_id: { type: string, in: path, required: true }
      pagination: none

    enable_email_routing:
      method: POST
      path: /zones/{zone_id}/email/routing/dns
      access: write
      description: "Enable Email Routing on a zone: Cloudflare adds AND LOCKS the required MX records and the SPF TXT record at the zone apex. Existing foreign MX records must be removed first, otherwise the zone ends up with status 'misconfigured'. Returns the settings object -- check that status == 'ready'."
      params:
        zone_id: { type: string, in: path, required: true }
        name: { type: string, in: body, description: "Zone domain name (optional, defaults to the zone)" }
      pagination: none

    disable_email_routing:
      method: DELETE
      path: /zones/{zone_id}/email/routing/dns
      access: dangerous
      description: "Disable Email Routing on a zone and REMOVE the MX/SPF records it added. Incoming mail to the zone stops being routed immediately; routing rules and destination addresses are kept but become inactive."
      params:
        zone_id: { type: string, in: path, required: true }
        name: { type: string, in: body, description: "Zone domain name (optional, defaults to the zone)" }
      pagination: none

    unlock_email_routing_dns:
      method: PATCH
      path: /zones/{zone_id}/email/routing/dns
      access: write
      description: "Unlock the MX records that Email Routing locked so they can be edited with the DNS tools (status becomes 'unlocked'). Editing them can break routing; run enable_email_routing again to restore and re-lock the records."
      params:
        zone_id: { type: string, in: path, required: true }
        name: { type: string, in: body, description: "Zone domain name (optional, defaults to the zone)" }
      pagination: none

    # =========================================================================
    # EMAIL ROUTING -- Rules & catch-all (zone-scoped)
    # =========================================================================

    list_email_routing_rules:
      method: GET
      path: /zones/{zone_id}/email/routing/rules
      access: read
      description: "List the custom-address routing rules of a zone: id, name, enabled, priority, matchers [{type: literal | all, field: to, value}], actions [{type: forward | drop | worker, value: [target]}], source (api | wrangler). The catch-all rule is included as well (matchers [{type: all}], priority 2147483647) -- manage it via get/update_email_routing_catch_all, not via update_email_routing_rule."
      params:
        zone_id: { type: string, in: path, required: true }
        enabled: { type: boolean, in: query, description: "Filter by enabled state" }
        page: { type: integer, in: query }
        per_page: { type: integer, in: query }

    get_email_routing_rule:
      method: GET
      path: /zones/{zone_id}/email/routing/rules/{rule_id}
      access: read
      description: "Get one routing rule by id (matchers, actions, enabled, priority, source)."
      params:
        zone_id: { type: string, in: path, required: true }
        rule_id: { type: string, in: path, required: true, description: "Routing rule id from list_email_routing_rules" }
      pagination: none

    create_email_routing_rule:
      method: POST
      path: /zones/{zone_id}/email/routing/rules
      access: write
      description: "Create a routing rule for a custom address of the zone. matchers: [{type: 'literal', field: 'to', value: 'alias@yourzone.tld'}]. actions: [{type: 'forward', value: ['dest@example.net']}] forwards to exactly ONE destination address that is already VERIFIED in the account (create_email_destination_address + link click), [{type: 'drop'}] discards the mail, [{type: 'worker', value: ['script-name']}] hands it to an Email Worker. Lower priority number wins when several rules match. Requires Email Routing to be enabled on the zone."
      params:
        zone_id: { type: string, in: path, required: true }
        matchers: { type: array, in: body, required: true, description: "[{type: 'literal', field: 'to', value: 'alias@yourzone.tld'}]" }
        actions: { type: array, in: body, required: true, description: "[{type: 'forward' | 'drop' | 'worker', value: ['target']}] -- forward needs one verified destination address, drop takes no value" }
        name: { type: string, in: body, description: "Human-readable rule name" }
        enabled: { type: boolean, in: body, description: "Default true" }
        priority: { type: integer, in: body, description: "Lower number = evaluated first (default 0)" }
      pagination: none

    update_email_routing_rule:
      method: PUT
      path: /zones/{zone_id}/email/routing/rules/{rule_id}
      access: write
      description: "Replace a routing rule (PUT = full replace: matchers AND actions are required again, omitted name/enabled/priority fall back to their defaults). Use it to change the forward target, disable a rule, or re-prioritize. Forward actions need exactly one verified destination address."
      params:
        zone_id: { type: string, in: path, required: true }
        rule_id: { type: string, in: path, required: true, description: "Routing rule id from list_email_routing_rules" }
        matchers: { type: array, in: body, required: true, description: "[{type: 'literal', field: 'to', value: 'alias@yourzone.tld'}]" }
        actions: { type: array, in: body, required: true, description: "[{type: 'forward' | 'drop' | 'worker', value: ['target']}]" }
        name: { type: string, in: body }
        enabled: { type: boolean, in: body }
        priority: { type: integer, in: body }
      pagination: none

    delete_email_routing_rule:
      method: DELETE
      path: /zones/{zone_id}/email/routing/rules/{rule_id}
      access: dangerous
      description: "Delete a routing rule. Mail to that custom address is no longer matched and falls through to the catch-all rule (which drops by default)."
      params:
        zone_id: { type: string, in: path, required: true }
        rule_id: { type: string, in: path, required: true }
      pagination: none

    get_email_routing_catch_all:
      method: GET
      path: /zones/{zone_id}/email/routing/rules/catch_all
      access: read
      description: "Get the zone's catch-all rule -- what happens to mail for addresses no custom rule matches: enabled, actions [{type: forward | drop | worker, value}], matchers [{type: all}]."
      params:
        zone_id: { type: string, in: path, required: true }
      pagination: none

    update_email_routing_catch_all:
      method: PUT
      path: /zones/{zone_id}/email/routing/rules/catch_all
      access: write
      description: "Set the zone's catch-all rule: enable or disable it and choose the action -- forward all unmatched mail to one verified destination address ([{type: 'forward', value: ['dest@example.net']}]), drop it ([{type: 'drop'}]), or route it to an Email Worker ([{type: 'worker', value: ['script-name']}]). matchers must be [{type: 'all'}]. PUT = full replace."
      params:
        zone_id: { type: string, in: path, required: true }
        actions: { type: array, in: body, required: true, description: "[{type: 'forward' | 'drop' | 'worker', value: ['target']}]" }
        matchers: { type: array, in: body, required: true, description: "Always [{type: 'all'}]" }
        enabled: { type: boolean, in: body, description: "false disables the catch-all (unmatched mail is rejected)" }
        name: { type: string, in: body }
      pagination: none

    # =========================================================================
    # EMAIL ROUTING -- Destination addresses & cross-zone rules (account-scoped)
    # =========================================================================

    list_email_destination_addresses:
      method: GET
      path: /accounts/{account_id}/email/routing/addresses
      access: read
      description: "List the Email Routing destination addresses of the account (the mailboxes forward rules may deliver to): id, email, verified (timestamp, or null while the recipient has not clicked the verification link), created, modified. Without the verified filter ALL addresses are returned (verified and pending); verified=true or verified=false narrows the list. account_id is required; get it via list_accounts."
      params:
        account_id: { type: string, in: path, required: true }
        verified: { type: boolean, in: query, description: "true = only verified addresses, false = only unverified/pending ones; omit for all" }
        direction: { type: string, in: query, description: "asc or desc" }
        page: { type: integer, in: query }
        per_page: { type: integer, in: query }

    get_email_destination_address:
      method: GET
      path: /accounts/{account_id}/email/routing/addresses/{destination_address_id}
      access: read
      description: "Get one destination address by id, including its verified timestamp (null = not yet verified)."
      params:
        account_id: { type: string, in: path, required: true }
        destination_address_id: { type: string, in: path, required: true, description: "Destination address id from list_email_destination_addresses" }
      pagination: none

    create_email_destination_address:
      method: POST
      path: /accounts/{account_id}/email/routing/addresses
      access: write
      description: "Register a destination address for forwarding. Cloudflare immediately emails a verification link to that address; until the recipient clicks it, verified stays null and routing rules that forward to it are rejected. Returns the address object (id, email, verified: null)."
      params:
        account_id: { type: string, in: path, required: true }
        email: { type: string, in: body, required: true, description: "Mailbox that should receive forwarded mail, e.g. inbox@example.net" }
      pagination: none

    update_email_destination_address:
      method: PATCH
      path: /accounts/{account_id}/email/routing/addresses/{destination_address_id}
      access: write
      description: "Change a destination address status. With a regular API token this can only reset a verified address to 'unverified' (forcing re-verification); setting 'verified' requires Cloudflare admin privileges and is rejected otherwise."
      params:
        account_id: { type: string, in: path, required: true }
        destination_address_id: { type: string, in: path, required: true }
        status: { type: string, in: body, required: true, description: "unverified or verified" }
      pagination: none

    delete_email_destination_address:
      method: DELETE
      path: /accounts/{account_id}/email/routing/addresses/{destination_address_id}
      access: dangerous
      description: "Delete a destination address. Routing rules that forward to it stop working -- update or delete those rules first. Cloudflare refuses to delete an address that was created only moments ago (HTTP 429 code 2032 'created too recently') -- wait a few minutes and retry."
      params:
        account_id: { type: string, in: path, required: true }
        destination_address_id: { type: string, in: path, required: true }
      pagination: none

    list_email_routing_rules_across_zones:
      method: GET
      path: /accounts/{account_id}/email/routing/rules
      access: read
      description: "List the routing rules of ALL zones in the account in one call; each rule carries zone {name, tag} in addition to id, name, enabled, priority, matchers, actions. Use it to audit which custom addresses forward where without iterating zones. Permission caveat: a token whose Email Routing Rules permission is granted per zone gets HTTP 403 (code 10000) here even though the per-zone list_email_routing_rules works -- fall back to iterating zones in that case."
      params:
        account_id: { type: string, in: path, required: true }
        enabled: { type: boolean, in: query, description: "Filter by enabled state" }
        page: { type: integer, in: query }
        per_page: { type: integer, in: query }

    # =========================================================================
    # EMAIL SENDING -- Send, quota, reputation (account-scoped)
    # =========================================================================

    send_email:
      method: POST
      path: /accounts/{account_id}/email/sending/send
      access: write
      description: "Send an outbound email through Cloudflare Email Sending. from must be an address on an ENABLED sending subdomain of the account (create_email_sending_subdomain, DNS status 'ready'); recipients can be any external addresses. Every address value is either a plain string 'user@example.com' or {address, name}; to/cc/bcc take arrays of those and at least one of the three is required. Provide subject and at least one of text/html. Returns {message_id, delivered[], queued[], permanent_bounces[], suppressed_recipients[]}. Each send counts against the daily quota (get_email_sending_limits)."
      params:
        account_id: { type: string, in: path, required: true }
        from: { type: object, in: body, required: true, description: "Sender: 'noreply@mail.example.com' or {address: 'noreply@mail.example.com', name: 'Display Name'} -- must be on an enabled sending subdomain" }
        to: { type: array, in: body, description: "Recipients: ['a@example.net', {address: 'b@example.org', name: 'B'}]. Optional only when cc or bcc is given" }
        cc: { type: array, in: body, description: "Carbon-copy recipients, same format as to" }
        bcc: { type: array, in: body, description: "Blind-carbon-copy recipients, same format as to" }
        reply_to: { type: object, in: body, description: "'user@example.com' or {address, name}" }
        subject: { type: string, in: body, required: true }
        text: { type: string, in: body, description: "Plain-text body (at least one of text/html)" }
        html: { type: string, in: body, description: "HTML body (at least one of text/html)" }
        headers: { type: object, in: body, description: "Additional headers as {Header-Name: value}" }
        attachments: { type: array, in: body, description: "[{disposition: 'attachment' | 'inline', filename, type: 'application/pdf', content: '<base64>', content_id: 'logo'}] -- content_id only for inline, referenced from html as cid:logo" }
      pagination: none

    send_email_raw:
      method: POST
      path: /accounts/{account_id}/email/sending/send_raw
      access: write
      description: "Send a pre-built RFC 5322 MIME message (headers + body, optionally multipart) through Email Sending. from and recipients form the SMTP envelope and must be plain addresses; the message's From header must still use an enabled sending subdomain. Prefer send_email unless you need full control over the MIME structure. Returns {message_id, delivered[], queued[], permanent_bounces[], suppressed_recipients[]}."
      params:
        account_id: { type: string, in: path, required: true }
        from: { type: string, in: body, required: true, description: "Envelope sender (MAIL FROM), plain address on an enabled sending subdomain" }
        recipients: { type: array, in: body, required: true, description: "Envelope recipients (RCPT TO), plain addresses" }
        mime_message: { type: string, in: body, required: true, description: "Complete MIME message including From, To, Subject and Content-Type headers" }
      pagination: none

    get_email_sending_limits:
      method: GET
      path: /accounts/{account_id}/email/sending/limits
      access: read
      description: "Get the account's Email Sending quota and current usage: {quota: {value, unit: day | hour}, usage: {sent, over_quota, resets_at}}. quota and usage are null while no quota is resolved yet (Email Sending not activated). Check before bulk sends."
      params:
        account_id: { type: string, in: path, required: true }
      pagination: none

    get_email_sending_reputation:
      method: GET
      path: /accounts/{account_id}/email/sending/reputation
      access: read
      description: "Get the account's Email Sending reputation: status (healthy | warning | at_risk | suspended), status_since, evaluated_at, grace_started_at, and the active_policy thresholds (complaint, customer_bounce and spam_rejection rates with warning_at/at_risk_at/minimum_denominator, suspension_after_hours). While suspended, sends are rejected. Accounts that have not activated Email Sending get HTTP 404 (code 10001 'Unable to authenticate request') from this endpoint even with the right permission -- check get_email_sending_limits (quota null) first."
      params:
        account_id: { type: string, in: path, required: true }
      pagination: none

    get_email_sending_message:
      method: GET
      path: /accounts/{account_id}/email/sending/messages/{message_id}
      access: read
      description: "Fetch the raw RFC 5322 MIME of a message sent via Email Sending, by the message_id returned from send_email / send_email_raw. The body is message/rfc822 (not JSON), so ToolMesh returns a file-broker download URL. Only available for subdomains with preview_enabled=true (activity-log preview)."
      params:
        account_id: { type: string, in: path, required: true }
        message_id: { type: string, in: path, required: true, description: "message_id from the send response" }
      response:
        binary: true
        content_type: message/rfc822
      pagination: none

    # =========================================================================
    # EMAIL SENDING -- Suppressions (account-scoped, cursor-paginated)
    # =========================================================================

    list_email_sending_suppressions:
      method: GET
      path: /accounts/{account_id}/email/sending/suppressions
      access: read
      description: "List active Email Sending suppressions (addresses that will NOT be delivered to): id, email, reason (manual | complaint | hard_bounce | soft_bounce | policy), scope ({type: 'account'} or {type: 'sending_domain', value}), expires_at (null = permanent), read_only, note. Sending-domain suppressions come first, then account-wide ones. CURSOR pagination unlike the rest of the API: the result is {suppressions: [...], next_cursor}; pass next_cursor as cursor to fetch the next page (page/per_page paging does not apply)."
      params:
        account_id: { type: string, in: path, required: true }
        per_page: { type: integer, in: query, description: "Max suppressions per page (API default 100)" }
        cursor: { type: string, in: query, description: "next_cursor from the previous response" }
        email: { type: string, in: query, description: "Exact email address filter" }
        search: { type: string, in: query, description: "Full address = exact match; 'user@' matches that user on every domain" }
        reason: { type: string, in: query, description: "manual, complaint, hard_bounce, soft_bounce, policy" }
        scope_type: { type: string, in: query, description: "account or sending_domain" }
        scope_value: { type: string, in: query, description: "Exact sending domain; requires scope_type=sending_domain" }
      response:
        result_path: "$"
        transform: |
          { suppressions: .result, next_cursor: (.result_info.next_cursor // null) }
      pagination: none

    get_email_sending_suppression:
      method: GET
      path: /accounts/{account_id}/email/sending/suppressions/{suppression_id}
      access: read
      description: "Get one Email Sending suppression by id (email, reason, scope, expires_at, read_only, note)."
      params:
        account_id: { type: string, in: path, required: true }
        suppression_id: { type: string, in: path, required: true }
      pagination: none

    create_email_sending_suppression:
      method: POST
      path: /accounts/{account_id}/email/sending/suppressions
      access: write
      description: "Suppress an address so Email Sending never delivers to it -- for every sending domain of the account by default, or for one sending domain via scope {type: 'sending_domain', value: 'mail.example.com'}. Creating an already active suppression returns its existing id. Scope is immutable afterwards (delete and recreate to change it). Returns {id, scope}."
      params:
        account_id: { type: string, in: path, required: true }
        email: { type: string, in: body, required: true, description: "Address to suppress" }
        expires_at: { type: string, in: body, description: "ISO 8601 expiry; omit for a permanent suppression" }
        note: { type: string, in: body, description: "Advisory note (free text, not enforced)" }
        scope: { type: object, in: body, description: "{type: 'account'} (default) or {type: 'sending_domain', value: 'mail.example.com'}" }
      pagination: none

    bulk_create_email_sending_suppressions:
      method: POST
      path: /accounts/{account_id}/email/sending/suppressions/bulk
      access: write
      description: "Import up to 1,000 Email Sending suppressions in one request. items: [{email, expires_at?, note?, scope?}] with the same semantics as create_email_sending_suppression; duplicates (same email + scope) are deduplicated. Returns counts (total, processed, deduplicated, invalid, skipped, errors) and per-item results {index, email, status: processed | invalid | error | skipped, id?, error?} in request order."
      params:
        account_id: { type: string, in: path, required: true }
        items: { type: array, in: body, required: true, description: "[{email: 'a@example.net', expires_at: '2027-01-01T00:00:00Z', note: 'bounced', scope: {type: 'account'}}]" }
      pagination: none

    update_email_sending_suppression:
      method: PATCH
      path: /accounts/{account_id}/email/sending/suppressions/{suppression_id}
      access: write
      description: "Update the expiry or note of a suppression. Send expires_at as null to make it permanent, note as '' to clear it; omitted fields stay unchanged. Scope cannot be changed (400 scope_immutable) and read_only suppressions (reason policy) cannot be edited."
      params:
        account_id: { type: string, in: path, required: true }
        suppression_id: { type: string, in: path, required: true }
        expires_at: { type: string, in: body, description: "New ISO 8601 expiry, or null for permanent" }
        note: { type: string, in: body, description: "Replacement note; empty string clears it" }
      pagination: none

    delete_email_sending_suppression:
      method: DELETE
      path: /accounts/{account_id}/email/sending/suppressions/{suppression_id}
      access: dangerous
      description: "Delete a suppression so the address can receive Email Sending mail again."
      params:
        account_id: { type: string, in: path, required: true }
        suppression_id: { type: string, in: path, required: true }
      pagination: none

    # =========================================================================
    # EMAIL SENDING -- Sending subdomains & their DNS (zone-scoped)
    # =========================================================================

    list_email_sending_subdomains:
      method: GET
      path: /zones/{zone_id}/email/sending/subdomains
      access: read
      description: "List the sending-enabled (sub)domains of a zone: tag (this is the subdomain_id for the other subdomain tools), name, enabled, dkim_selector, return_path_domain, preview_enabled, drop_suppressed_recipients. A zone has none until create_email_sending_subdomain is called."
      params:
        zone_id: { type: string, in: path, required: true }
      pagination: none

    get_email_sending_subdomain:
      method: GET
      path: /zones/{zone_id}/email/sending/subdomains/{subdomain_id}
      access: read
      description: "Get one sending subdomain by id (the tag field of list_email_sending_subdomains)."
      params:
        zone_id: { type: string, in: path, required: true }
        subdomain_id: { type: string, in: path, required: true, description: "tag from list_email_sending_subdomains" }
      pagination: none

    create_email_sending_subdomain:
      method: POST
      path: /zones/{zone_id}/email/sending/subdomains
      access: write
      description: "Enable Email Sending on a domain of the zone, e.g. 'mail.example.com' or the apex 'example.com' ('*.example.com' wildcards need the wildcard entitlement). Cloudflare creates and locks the DKIM, SPF, DMARC and return-path DNS records and returns the subdomain (tag = subdomain_id). Run preview_email_sending_subdomain first to detect conflicts with existing MX/SPF/DMARC records, then confirm readiness with get_email_sending_subdomain_dns_status. Also re-enables a previously deleted subdomain."
      params:
        zone_id: { type: string, in: path, required: true }
        name: { type: string, in: body, required: true, description: "Domain within the zone, e.g. mail.example.com" }
      pagination: none

    preview_email_sending_subdomain:
      method: POST
      path: /zones/{zone_id}/email/sending/subdomains/preview
      access: read
      description: "Dry run for create_email_sending_subdomain: returns the DNS records Cloudflare would create for the name plus errors[] with codes such as mx.missing, mx.foreign, spf.multiple, dkim.conflict, dmarc.incompatible, sending_subdomain.conflict (each with the existing/missing/multiple records involved). Nothing is created or modified."
      params:
        zone_id: { type: string, in: path, required: true }
        name: { type: string, in: body, required: true, description: "Domain within the zone to check, e.g. mail.example.com" }
      pagination: none

    update_email_sending_subdomain:
      method: PATCH
      path: /zones/{zone_id}/email/sending/subdomains/{subdomain_id}
      access: write
      description: "Update a sending subdomain (at least one field required): preview_enabled lets sent messages be previewed in the activity log (needed for get_email_sending_message); drop_suppressed_recipients=true makes send_email drop suppressed recipients and deliver to the rest instead of failing the whole request."
      params:
        zone_id: { type: string, in: path, required: true }
        subdomain_id: { type: string, in: path, required: true }
        preview_enabled: { type: boolean, in: body }
        drop_suppressed_recipients: { type: boolean, in: body }
      pagination: none

    delete_email_sending_subdomain:
      method: DELETE
      path: /zones/{zone_id}/email/sending/subdomains/{subdomain_id}
      access: dangerous
      description: "Disable sending on the subdomain and remove its sending DNS records (DKIM/SPF/DMARC/return-path). Email Routing on the same name is unaffected. Sends with a from address on this subdomain fail afterwards."
      params:
        zone_id: { type: string, in: path, required: true }
        subdomain_id: { type: string, in: path, required: true }
      pagination: none

    get_email_sending_subdomain_dns:
      method: GET
      path: /zones/{zone_id}/email/sending/subdomains/{subdomain_id}/dns
      access: read
      description: "Return the DNS records a sending subdomain is expected to have (desired state as {type, name, content, priority, ttl}) -- no live comparison; use get_email_sending_subdomain_dns_status for that."
      params:
        zone_id: { type: string, in: path, required: true }
        subdomain_id: { type: string, in: path, required: true }
      pagination: none

    get_email_sending_subdomain_dns_status:
      method: GET
      path: /zones/{zone_id}/email/sending/subdomains/{subdomain_id}/dns/status
      access: read
      description: "Live DNS health of a sending subdomain: status (ready | unconfigured | unlocked | misconfigured), the desired records, and errors[] (mx.missing, mx.foreign, spf.missing, spf.foreign, spf.multiple, dkim.missing, dkim.conflict, dmarc.missing, dmarc.multiple, dmarc.incompatible, domainkey.delegated, sending_subdomain.conflict). Call this before fix_email_sending_subdomain_dns."
      params:
        zone_id: { type: string, in: path, required: true }
        subdomain_id: { type: string, in: path, required: true }
      pagination: none

    fix_email_sending_subdomain_dns:
      method: POST
      path: /zones/{zone_id}/email/sending/subdomains/{subdomain_id}/dns
      access: write
      description: "Idempotently repair a sending subdomain's DNS: re-creates missing sending records and re-applies the lock on unlocked ones. Refuses with HTTP 409 while foreign MX, multiple SPF, multiple DMARC or multiple DKIM records exist at the relevant names -- clean those up with the DNS tools first. Returns the same shape as get_email_sending_subdomain_dns_status."
      params:
        zone_id: { type: string, in: path, required: true }
        subdomain_id: { type: string, in: path, required: true }
      pagination: none

    get_email_sending_subdomain_complaints:
      method: GET
      path: /zones/{zone_id}/email/sending/subdomains/{subdomain_id}/reputation/complaints
      access: read
      description: "Number of spam complaints matched to a sending subdomain in the half-open window [start_at, end_at), at most seven days long. Returns {complaints}."
      params:
        zone_id: { type: string, in: path, required: true }
        subdomain_id: { type: string, in: path, required: true }
        start_at: { type: string, in: query, required: true, description: "ISO 8601 window start (inclusive)" }
        end_at: { type: string, in: query, required: true, description: "ISO 8601 window end (exclusive), at most 7 days after start_at" }
      pagination: none

    # =========================================================================
    # EMAIL AUTH -- DMARC reports & SPF inspection (zone-scoped)
    # =========================================================================

    get_dmarc_reports_status:
      method: GET
      path: /zones/{zone_id}/email/auth/dmarc-reports
      access: read
      description: "Get the zone's DMARC Management state: enabled (Cloudflare collects DMARC aggregate reports through its RUA address), rua_prefix, status (missing-dmarc-report | multiple-dmarc-reports | missing-dmarc-rua | cname-on-dmarc-record | unauthorized-reporting-domain; the field is absent when DMARC is configured correctly), approved_sources (sending sources seen in reports, with resolved IPs) and records -- the zone's live SPF, DKIM, DMARC and BIMI TXT/CNAME records grouped by type. A good first call for any email-deliverability audit of a zone."
      params:
        zone_id: { type: string, in: path, required: true }
      pagination: none

    configure_dmarc_reports:
      method: PATCH
      path: /zones/{zone_id}/email/auth/dmarc-reports
      access: write
      description: "Enable or disable Cloudflare DMARC report collection for the zone (at least one of enabled/skip_wizard required). enabled=true ensures the zone's DMARC TXT record carries Cloudflare's rua= reporting address (creating it if needed) so aggregate reports flow into DMARC Management. Returns the same shape as get_dmarc_reports_status."
      params:
        zone_id: { type: string, in: path, required: true }
        enabled: { type: boolean, in: body, description: "Turn DMARC aggregate-report collection on or off" }
        skip_wizard: { type: boolean, in: body, description: "Skip the dashboard DMARC setup wizard" }
      pagination: none

    inspect_spf_record:
      method: GET
      path: /zones/{zone_id}/email/auth/spf/inspect
      access: read
      description: "Parse one SPF TXT record of the zone into a component tree: every mechanism (A, MX, IP4, IP6, INCLUDE, REDIRECT, EXISTS, PTR, ALL) with its qualifier result, nested includes resolved recursively, lookup_count per component and total_lookups (RFC 7208 allows 10), plus errors[] (lookup_failed, spf_not_found, invalid_spf, invalid_domain, loop_detected, invalid_mechanism, ...). id is the DNS record id of the SPF TXT record -- find it with list_dns_records(type='TXT')."
      params:
        zone_id: { type: string, in: path, required: true }
        id: { type: string, in: query, required: true, description: "DNS record id of the SPF TXT record (from list_dns_records)" }
      pagination: none

  # ===========================================================================
  # EXAMPLES
  # ===========================================================================

  examples:
    - name: "Setup DNS for a new domain"
      description: "Find a zone and create common DNS records (A, CNAME, MX, TXT)"
      code: |
        const zones = await api.list_zones({ name: "example.com" });
        const zoneId = zones[0].id;
        await api.create_dns_record({ zone_id: zoneId, type: "A", name: "@", content: "203.0.113.1", proxied: true, ttl: 1 });
        await api.create_dns_record({ zone_id: zoneId, type: "CNAME", name: "www", content: "example.com", proxied: true, ttl: 1 });
        await api.create_dns_record({ zone_id: zoneId, type: "MX", name: "@", content: "mail.example.com", priority: 10, ttl: 3600 });
        await api.create_dns_record({ zone_id: zoneId, type: "TXT", name: "@", content: "v=spf1 include:_spf.google.com ~all", ttl: 3600 });
        return await api.list_dns_records({ zone_id: zoneId });

    - name: "Deploy and configure Pages project"
      description: "Create a Pages project, add a custom domain, and list deployments"
      code: |
        const project = await api.create_pages_project({
          account_id: accountId,
          name: "my-site",
          production_branch: "main",
          build_config: { build_command: "npm run build", destination_dir: "dist" }
        });
        await api.add_pages_domain({ account_id: accountId, project_name: "my-site", name: "www.example.com" });
        const deployments = await api.list_pages_deployments({ account_id: accountId, project_name: "my-site" });
        return { project, deployments };

    - name: "Purge cache and check settings"
      description: "Purge all cached content for a zone and verify cache settings"
      code: |
        await api.purge_cache({ zone_id: zoneId, purge_everything: true });
        const settings = await api.list_zone_settings({ zone_id: zoneId });
        const cacheSettings = settings.filter(s => ["browser_cache_ttl", "cache_level", "development_mode"].includes(s.id));
        return cacheSettings;

    - name: "Audit and lock Registrar domains"
      description: "List Cloudflare Registrar domains and enable auto-renew plus registrar lock on each"
      code: |
        const domains = await api.list_registrar_domains({ account_id: accountId });
        for (const d of domains) {
          await api.update_registrar_domain({
            account_id: accountId,
            domain_name: d.name,
            auto_renew: true,
            locked: true
          });
        }
        return domains.map(d => ({ name: d.name, expires_at: d.expires_at }));

    - name: "Configure Cloudflare as secondary DNS"
      description: "Create an account-scoped peer, then point a zone's incoming transfer at it"
      code: |
        const peer = await api.create_dns_peer({
          account_id: accountId,
          name: "primary-ns1",
          ip: "203.0.113.53",
          port: 53,
          ixfr_enable: true
        });
        return await api.create_secondary_dns_incoming({
          zone_id: zoneId,
          name: "example.com",
          peers: [peer.id],
          auto_refresh_seconds: 86400
        });

    - name: "Set up email forwarding for a domain"
      description: "Register a destination mailbox, enable Email Routing on the zone, forward one alias to it and drop everything else"
      code: |
        const dest = await api.create_email_destination_address({ account_id: accountId, email: "inbox@example.net" });
        // The recipient must click the verification link Cloudflare sends before rules can forward to it.
        await api.enable_email_routing({ zone_id: zoneId });
        await api.create_email_routing_rule({
          zone_id: zoneId,
          name: "hello alias",
          matchers: [{ type: "literal", field: "to", value: "hello@example.com" }],
          actions: [{ type: "forward", value: [dest.email] }]
        });
        await api.update_email_routing_catch_all({
          zone_id: zoneId,
          name: "catch-all",
          enabled: true,
          matchers: [{ type: "all" }],
          actions: [{ type: "drop" }]
        });
        return await api.list_email_routing_rules({ zone_id: zoneId });

    - name: "Send a transactional email"
      description: "Check the daily quota, then send an HTML email from a sending subdomain"
      code: |
        const limits = await api.get_email_sending_limits({ account_id: accountId });
        if (limits.usage && limits.usage.over_quota) throw new Error("daily sending quota exhausted");
        return await api.send_email({
          account_id: accountId,
          from: { address: "noreply@mail.example.com", name: "Example App" },
          to: ["user@example.net"],
          subject: "Your report is ready",
          text: "Your report is ready. Open the dashboard to view it.",
          html: "<p>Your report is ready. <a href='https://example.com/reports'>Open the dashboard</a>.</p>"
        });

    update_access_app_policy:
      method: PUT
      path: /accounts/{account_id}/access/apps/{app_id}/policies/{policy_id}
      access: write
      description: "Update a policy for an Access application"
      params:
        account_id: { type: string, in: path, required: true }
        app_id: { type: string, in: path, required: true }
        policy_id: { type: string, in: path, required: true }
        name: { type: string, in: body }
        decision: { type: string, in: body }
        include: { type: array, in: body }
        exclude: { type: array, in: body }
        require: { type: array, in: body }
      pagination: none

    delete_access_app_policy:
      method: DELETE
      path: /accounts/{account_id}/access/apps/{app_id}/policies/{policy_id}
      access: dangerous
      description: "Delete a policy for an Access application"
      params:
        account_id: { type: string, in: path, required: true }
        app_id: { type: string, in: path, required: true }
        policy_id: { type: string, in: path, required: true }

        app_id: { type: string, in: path, required: true }

    get_access_app_policy:
      method: GET
      path: /accounts/{account_id}/access/apps/{app_id}/policies/{policy_id}
      access: read
      description: "Get a specific policy for an Access application"
      params:
        account_id: { type: string, in: path, required: true }
        app_id: { type: string, in: path, required: true }
        policy_id: { type: string, in: path, required: true }
      pagination: none

    create_access_app_policy:
      method: POST
      path: /accounts/{account_id}/access/apps/{app_id}/policies
      access: write
      description: "Create a policy for a specific Access application"
      params:

    add_ipsec_connection:
      method: POST
      path: /ipsec/connections/add_connection
      access: write
      description: "Create a new IPsec connection"
      params:
        connection.enabled: { type: string, in: body, default: "1" }
        connection.description: { type: string, in: body }
        connection.version: { type: string, in: body, description: "IKE version: 1, 2" }
        connection.proposals: { type: string, in: body, description: "IKE proposals (e.g. aes256-sha256-modp2048)" }
        connection.rekey_time: { type: string, in: body }
        connection.dpd_delay: { type: string, in: body }
      pagination: none

    set_ipsec_connection:
      method: POST
      path: /ipsec/connections/set_connection/{uuid}
      access: write
      description: "Update an IPsec connection"

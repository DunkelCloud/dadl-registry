        uuid: { type: string, in: path, required: true }
        connection.enabled: { type: string, in: body }
        connection.description: { type: string, in: body }
        connection.version: { type: string, in: body, description: "IKE version: 1, 2" }
        connection.proposals: { type: string, in: body, description: "IKE proposals (e.g. aes256-sha256-modp2048)" }
        connection.rekey_time: { type: string, in: body }
        connection.dpd_delay: { type: string, in: body }
      pagination: none
    del_ipsec_connection:

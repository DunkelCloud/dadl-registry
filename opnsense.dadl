    get_syslog_stats:
      method: GET
      path: /syslog/service/stats
      access: read
      description: "Get syslog service statistics"
      pagination: none

    # =========================================================================
    # CRON
    # =========================================================================

    search_cron_jobs:
      method: POST
      path: /cron/settings/search_jobs
      access: read
      description: "Search scheduled cron jobs"
      params:
        current: { type: integer, in: body, default: 1 }

        ca.descr: { type: string, in: body, required: true }
        ca.action: { type: string, in: body, required: true, description: "internal, existing, import" }
        ca.key_type: { type: string, in: body }
        ca.digest: { type: string, in: body }
        ca.lifetime: { type: integer, in: body }
        ca.cn: { type: string, in: body }
      response:
        result_path: "$"
      pagination: none

    set_ca:
      method: POST
      path: /trust/ca/set/{uuid}
      access: write

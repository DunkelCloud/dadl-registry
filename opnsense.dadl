        job.hours: { type: string, in: body, required: true }
        job.days: { type: string, in: body, required: true }
        job.months: { type: string, in: body, required: true }
        job.weekdays: { type: string, in: body, required: true }
        job.command: { type: string, in: body, required: true }
        job.description: { type: string, in: body }

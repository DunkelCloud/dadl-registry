        destination.transport: { type: string, in: body, description: "udp4, udp6, tcp4, tcp6, tls4, tls6" }
        destination.hostname: { type: string, in: body }
        destination.port: { type: string, in: body }
        destination.rfc5424: { type: string, in: body, description: "1=use RFC 5424 format" }
        destination.description: { type: string, in: body }
      pagination: none
    del_syslog_destination:
      method: POST
      path: /syslog/settings/del_destination/{uuid}

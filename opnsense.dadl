      access: write
      description: "Update a traffic shaper pipe (bandwidth limit)"
      params:
        uuid: { type: string, in: path, required: true }
        pipe.enabled: { type: string, in: body }
        pipe.bandwidth: { type: integer, in: body }
        pipe.bandwidthMetric: { type: string, in: body, description: "Kbit, Mbit, Gbit" }
        pipe.description: { type: string, in: body }
      response:
        result_path: "$"
      pagination: none
    del_shaper_pipe:
      method: POST
      path: /trafficshaper/settings/del_pipe/{uuid}
      access: dangerous
      description: "Delete a traffic shaper pipe"

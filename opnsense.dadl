    set_cron_job:
      method: POST
      path: /cron/settings/set_job/{uuid}
      access: write
      description: "Update a scheduled cron job"
      params:
        uuid: { type: string, in: path, required: true }
        job.enabled: { type: string, in: body }
        job.minutes: { type: string, in: body }
        job.hours: { type: string, in: body }
        job.days: { type: string, in: body }
        job.months: { type: string, in: body }
        job.weekdays: { type: string, in: body }
        job.command: { type: string, in: body }
        job.description: { type: string, in: body }

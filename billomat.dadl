      access: read
      description: "Retrieve a single delivery note line item by ID"
      params:
        id: { type: string, in: path, required: true }
      response:
        result_path: "$.delivery-note-item"
      pagination: none

    create_delivery_note_item:
      method: POST
      path: /delivery-note-items
      access: write
      description: "Add a line item to a delivery note."
      params:
        delivery-note-item:
          type: object
